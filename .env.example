# Copy to .env and adjust if needed. Every value has a safe default.

# The lab gateway accepts only http://localhost:3000 or http://127.0.0.1:3000.
BASE_URL=http://localhost:3000

# Seeded demo account from qa-commerce-lab.
DEMO_EMAIL=qa@example.com
DEMO_PASSWORD=Testing123!

# How long to wait for an asynchronous order to reach a terminal state (ms).
ORDER_TIMEOUT_MS=15000
