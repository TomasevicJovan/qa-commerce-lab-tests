# Copy to .env and fill in. .env is ignored by git; never commit real values.
# In CI the same names are repository secrets (Settings → Secrets and variables → Actions).

# The lab gateway accepts only http://localhost:3000 or http://127.0.0.1:3000.
BASE_URL=http://localhost:3000

# Seeded demo account of qa-commerce-lab (see its README). Required.
DEMO_EMAIL=
DEMO_PASSWORD=

# How long to wait for an asynchronous order to reach a terminal state (ms).
ORDER_TIMEOUT_MS=15000

# Optional: repeat the generated test data of an earlier run (the seed is printed at the start of every run).
# TEST_SEED=
